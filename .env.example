# =====================================
# B站直播间配置
# =====================================

# 直播间ID
BILIBILI_ROOM_ID=22900497

# B站登录凭证（SESSDATA用于弹幕监听）
# 从浏览器Cookie中获取
BILIBILI_SESSDATA=your_sessdata_here
BILIBILI_BILI_JCT=your_bili_jct_here
BILIBILI_BUVID3=your_buvid3_here

# =====================================
# Flask 配置
# =====================================

# 密钥（用于Session加密，请使用随机生成的强密钥）
FLASK_SECRET_KEY=your-secret-key-here

# 调试模式（生产环境请设为False）
FLASK_DEBUG=False

# 监听地址和端口
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# =====================================
# 数据库配置
# =====================================

# SQLite 数据库路径
DATABASE_URL=sqlite:///data/database.db

# =====================================
# HTTPS 配置（可选）
# =====================================

# 是否启用HTTPS
SSL_ENABLED=false

# SSL证书和密钥路径
SSL_CERT_FILE=/path/to/cert.pem
SSL_KEY_FILE=/path/to/key.pem
SSL_PORT=7112

# Copy this file to .env once, then replace the values.
# Docker Compose reads .env automatically. Do not export a new temporary
# INTERNAL_API_SECRET for each shell; all runtime roles must share this stable value.

# Internal API shared secret for web / danmaku-worker / scheduler.
# Generate once and keep it stable, for example:
#   python - <<'PY'
#   import secrets
#   print(secrets.token_hex(32))
#   PY
INTERNAL_API_SECRET=replace-with-one-stable-64-hex-secret
